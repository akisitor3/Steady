{
  "expo": {
    "name": "Steady",
    "slug": "steady",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "steady",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steady.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.steady.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0F6E56"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
